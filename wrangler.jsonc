{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-23",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sundari-cosmetics",
			"database_id": "c4d91484-f6bc-4a15-a060-a77ae7537666",
			"remote": true
		}
	],
	"compatibility_flags": [
		"nodejs_compat"
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
