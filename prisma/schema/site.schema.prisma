model SiteData {
    id Int @id @default(autoincrement())
    siteName String
    logo String
    ribbonText String
    footerText String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Menus{
    id Int @id @default(autoincrement())
    name String
    url String
    type String
    parentId Int?
    position String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Socials{
    id Int @id @default(autoincrement())
    platform String
    url String
    icon String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}