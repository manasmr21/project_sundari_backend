model Users {
    id        String     @id @default(uuid())
    fullname  String
    email     String     @unique
    password  String
    roleId    Int
    role      Roles      @relation(fields: [roleId], references: [id])
    verified  Boolean    @default(false)
    addresses Address[]
    orders    Orders[]
    cart      Cart[]
    wishlist  Wishlist[]
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
}